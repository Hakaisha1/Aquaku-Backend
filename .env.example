# Rancangan konfigurasi awal; belum dibaca oleh aplikasi.
# Sesuaikan nama variabel saat framework backend ditentukan.
APP_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL: akun, membership, listing, kuota, rating, dan laporan.
# Ganti kredensial contoh sebelum digunakan.
DATABASE_URL=postgresql://aquaku:aquaku_dev_password@127.0.0.1:5433/aquaku

# MongoDB: posting forum, komentar, dan tank profile.

# Isi dengan dua secret acak yang berbeda; jangan gunakan nilai contoh.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Isi dengan origin frontend yang diizinkan saat frontend tersedia.
CORS_ORIGIN=

# Provider object storage dan OTP belum dipilih.
# Tambahkan variabel provider saat integrasi diimplementasikan.
