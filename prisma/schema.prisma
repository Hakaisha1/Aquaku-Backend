generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  PERSONAL
  TOKO
  JURAGAN
}

enum UserRole {
  MEMBER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  INACTIVE
}

enum ListingSuspensionReason {
  TIER_CONDITION
  QUOTA
}

enum SaleTransactionStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  SCAM
  PROHIBITED_ITEM
  MISLEADING
  HARASSMENT
  OTHER
}

enum ListingModerationAction {
  HIDE
  RESTORE
}

enum SaleTransactionCorrectionAction {
  BUYER_CORRECTED
}

enum BenefitRequestKind {
  MEMBERSHIP
  SLOT_ADDON
  COOLDOWN_BYPASS
  SHOP_VERIFICATION
}

enum BenefitRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingCondition {
  BNIB
  NEW
  LIKE_NEW
  SECOND
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(320)
  phoneNumber     String         @unique @map("phone_number") @db.VarChar(16)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  displayName     String         @map("display_name") @db.VarChar(80)
  avatarUrl       String?        @map("avatar_url") @db.VarChar(2048)
  whatsappNumber  String?        @map("whatsapp_number") @db.VarChar(16)
  bio             String?        @db.VarChar(500)
  phoneVerifiedAt DateTime?      @map("phone_verified_at") @db.Timestamptz(3)
  tier            Tier           @default(PERSONAL)
  tierExpiresAt   DateTime?      @map("tier_expires_at") @db.Timestamptz(3)
  verifiedStore   Boolean        @default(false) @map("verified_store")
  role            UserRole       @default(MEMBER)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  otpChallenge    OtpChallenge?
  refreshTokens   RefreshToken[]
  shop            Shop?
  listings        Listing[]
  mediaAssets     MediaAsset[]
  benefitRequests BenefitRequest[] @relation("BenefitRequestOwner")
  reviewedBenefitRequests BenefitRequest[] @relation("BenefitRequestReviewer")
  slotAddonGrants SlotAddonGrant[]
  cooldownPasses  CooldownPass[]
  salesAsSeller SaleTransaction[] @relation("SaleSeller")
  salesAsBuyer SaleTransaction[] @relation("SaleBuyer")
  ratingsReceived Rating[] @relation("RatingSeller")
  ratingsGiven Rating[] @relation("RatingBuyer")
  reportsMade Report[] @relation("ReportReporter")
  reportsAboutUser Report[] @relation("ReportTargetUser")
  reportsReviewed Report[] @relation("ReportReviewer")
  moderationActions ModerationAction[]
  saleCorrectionsAsAdmin SaleTransactionCorrection[] @relation("SaleCorrectionAdmin")
  saleCorrectionsAsPreviousBuyer SaleTransactionCorrection[] @relation("SaleCorrectionPreviousBuyer")
  saleCorrectionsAsNewBuyer SaleTransactionCorrection[] @relation("SaleCorrectionNewBuyer")
  personalCooldownUntil DateTime? @map("personal_cooldown_until") @db.Timestamptz(3)

  @@map("users")
}

model OtpChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  codeHash       String?  @map("code_hash") @db.VarChar(64)
  providerOtpId  String?  @unique @map("provider_otp_id") @db.VarChar(64)
  externalId     String?  @unique @map("external_id") @db.VarChar(64)
  providerStatus String?  @map("provider_status") @db.VarChar(16)
  attempts       Int      @default(0)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  lastSentAt     DateTime @map("last_sent_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Region {
  code          String    @id @db.VarChar(32)
  districtCode  String    @map("district_code") @db.VarChar(16)
  districtName  String    @map("district_name") @db.VarChar(100)
  villageName   String    @map("village_name") @db.VarChar(100)
  listings      Listing[]

  @@index([districtCode, villageName])
  @@map("regions")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(64)
  name      String    @db.VarChar(80)
  active    Boolean   @default(true)
  listings  Listing[]

  @@map("categories")
}

model ListingTag {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(64)
  name        String    @db.VarChar(80)
  minimumTier Tier      @default(PERSONAL) @map("minimum_tier")
  assignments ListingTagAssignment[]

  @@map("listing_tags")
}

model ListingTagAssignment {
  listingId String     @map("listing_id") @db.Uuid
  tagId     String     @map("tag_id") @db.Uuid
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag       ListingTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([listingId, tagId])
  @@index([tagId, listingId])
  @@map("listing_tag_assignments")
}

model Shop {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @unique @map("owner_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  verificationStatus ShopVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings    Listing[]
  benefitRequests BenefitRequest[]

  @@map("shops")
}

model Listing {
  id          String                   @id @default(uuid()) @db.Uuid
  sellerId    String                   @map("seller_id") @db.Uuid
  shopId      String?                  @map("shop_id") @db.Uuid
  categoryId  String                   @map("category_id") @db.Uuid
  regionCode  String                   @map("region_code") @db.VarChar(32)
  title       String                   @db.VarChar(120)
  description String                   @db.VarChar(5000)
  price       Int
  condition   ListingCondition
  status      ListingStatus            @default(ACTIVE)
  expiresAt   DateTime                 @map("expires_at") @db.Timestamptz(3)
  soldAt      DateTime?                @map("sold_at") @db.Timestamptz(3)
  deletedAt   DateTime?                @map("deleted_at") @db.Timestamptz(3)
  suspendedAt DateTime?                @map("suspended_at") @db.Timestamptz(3)
  suspensionReason ListingSuspensionReason? @map("suspension_reason")
  moderationHiddenAt DateTime?            @map("moderation_hidden_at") @db.Timestamptz(3)
  moderationReason String?                 @map("moderation_reason") @db.VarChar(500)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  seller      User                     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shop        Shop?                    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  category    Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  region      Region                   @relation(fields: [regionCode], references: [code], onDelete: Restrict)
  photos      MediaAsset[]
  tags        ListingTagAssignment[]
  saleTransactions SaleTransaction[]
  reports Report[] @relation("ReportTargetListing")
  moderationActions ModerationAction[]

  @@index([status, deletedAt, expiresAt])
  @@index([sellerId, status, deletedAt])
  @@index([categoryId, status, deletedAt])
  @@index([regionCode, status, deletedAt])
  @@index([price, status, deletedAt])
  @@map("listings")
}

model MediaAsset {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  listingId  String?   @map("listing_id") @db.Uuid
  publicId   String    @unique @map("public_id") @db.VarChar(255)
  secureUrl  String?   @map("secure_url") @db.VarChar(2048)
  format     String?   @db.VarChar(8)
  bytes      Int?
  signedAt   DateTime  @map("signed_at") @db.Timestamptz(3)
  uploadedAt DateTime? @map("uploaded_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listing    Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([ownerId, listingId])
  @@index([signedAt])
  @@map("media_assets")
}

model BenefitRequest {
  id                    String               @id @default(uuid()) @db.Uuid
  ownerId               String               @map("owner_id") @db.Uuid
  kind                  BenefitRequestKind
  status                BenefitRequestStatus @default(PENDING)
  requestedTier         Tier?                @map("requested_tier")
  requestedSlots        Int?                 @map("requested_slots")
  approvedSlots         Int?                 @map("approved_slots")
  paymentAmount         Int?                 @map("payment_amount")
  proofBytes            Bytes?               @map("proof_bytes") @db.ByteA
  proofMimeType         String?              @map("proof_mime_type") @db.VarChar(100)
  shopId                String?              @map("shop_id") @db.Uuid
  reviewedById          String?              @map("reviewed_by_id") @db.Uuid
  reviewNote            String?              @map("review_note") @db.VarChar(500)
  reviewedAt            DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  entitlementStartsAt   DateTime?            @map("entitlement_starts_at") @db.Timestamptz(3)
  entitlementExpiresAt  DateTime?            @map("entitlement_expires_at") @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                 User                 @relation("BenefitRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer              User?                @relation("BenefitRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  shop                  Shop?                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slotAddonGrant        SlotAddonGrant?
  cooldownPass          CooldownPass?

  @@index([ownerId, createdAt])
  @@index([status, kind, createdAt])
  @@map("benefit_requests")
}

model SlotAddonGrant {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  requestId String         @unique @map("request_id") @db.Uuid
  slots     Int
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  endedAt   DateTime?      @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   BenefitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, endedAt])
  @@map("slot_addon_grants")
}

model CooldownPass {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  requestId  String         @unique @map("request_id") @db.Uuid
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?      @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  request    BenefitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, consumedAt])
  @@map("cooldown_passes")
}

model SaleTransaction {
  id               String                 @id @default(uuid()) @db.Uuid
  listingId        String                 @map("listing_id") @db.Uuid
  sellerId         String                 @map("seller_id") @db.Uuid
  buyerId          String                 @map("buyer_id") @db.Uuid
  status           SaleTransactionStatus  @default(AWAITING_CONFIRMATION)
  responseNote     String?                @map("response_note") @db.VarChar(500)
  respondedAt      DateTime?              @map("responded_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  listing          Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller           User                   @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer            User                   @relation("SaleBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  rating           Rating?
  corrections      SaleTransactionCorrection[]

  @@index([listingId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@map("sale_transactions")
}

model Rating {
  id                 String          @id @default(uuid()) @db.Uuid
  saleTransactionId  String          @unique @map("sale_transaction_id") @db.Uuid
  buyerId            String          @map("buyer_id") @db.Uuid
  sellerId           String          @map("seller_id") @db.Uuid
  score              Int
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction        SaleTransaction @relation(fields: [saleTransactionId], references: [id], onDelete: Cascade)
  buyer              User            @relation("RatingBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller             User            @relation("RatingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@map("ratings")
}

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  reporterId      String       @map("reporter_id") @db.Uuid
  targetListingId String?      @map("target_listing_id") @db.Uuid
  targetUserId    String?      @map("target_user_id") @db.Uuid
  reason          ReportReason
  details         String?      @db.VarChar(1000)
  status          ReportStatus @default(OPEN)
  reviewedById    String?      @map("reviewed_by_id") @db.Uuid
  reviewNote      String?      @map("review_note") @db.VarChar(500)
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  reporter        User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetListing   Listing?     @relation("ReportTargetListing", fields: [targetListingId], references: [id], onDelete: Cascade)
  targetUser      User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  reviewer        User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model ModerationAction {
  id        String                  @id @default(uuid()) @db.Uuid
  listingId String                  @map("listing_id") @db.Uuid
  adminId   String                  @map("admin_id") @db.Uuid
  action    ListingModerationAction
  reason    String                  @db.VarChar(500)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  listing   Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin     User                    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([adminId, createdAt])
  @@map("moderation_actions")
}

model SaleTransactionCorrection {
  id              String                            @id @default(uuid()) @db.Uuid
  saleTransactionId String                          @map("sale_transaction_id") @db.Uuid
  adminId         String                            @map("admin_id") @db.Uuid
  previousBuyerId String                            @map("previous_buyer_id") @db.Uuid
  newBuyerId      String                            @map("new_buyer_id") @db.Uuid
  action          SaleTransactionCorrectionAction   @default(BUYER_CORRECTED)
  reason          String                            @db.VarChar(500)
  createdAt       DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  saleTransaction SaleTransaction                   @relation(fields: [saleTransactionId], references: [id], onDelete: Cascade)
  admin           User                              @relation("SaleCorrectionAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  previousBuyer   User                              @relation("SaleCorrectionPreviousBuyer", fields: [previousBuyerId], references: [id], onDelete: Restrict)
  newBuyer        User                              @relation("SaleCorrectionNewBuyer", fields: [newBuyerId], references: [id], onDelete: Restrict)

  @@index([saleTransactionId, createdAt])
  @@index([adminId, createdAt])
  @@map("sale_transaction_corrections")
}
