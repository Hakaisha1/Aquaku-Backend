generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  PERSONAL
  TOKO
  JURAGAN
}

enum UserRole {
  MEMBER
  ADMIN
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(320)
  phoneNumber     String         @unique @map("phone_number") @db.VarChar(16)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  displayName     String         @map("display_name") @db.VarChar(80)
  avatarUrl       String?        @map("avatar_url") @db.VarChar(2048)
  whatsappNumber  String?        @map("whatsapp_number") @db.VarChar(16)
  bio             String?        @db.VarChar(500)
  phoneVerifiedAt DateTime?      @map("phone_verified_at") @db.Timestamptz(3)
  tier            Tier           @default(PERSONAL)
  tierExpiresAt   DateTime?      @map("tier_expires_at") @db.Timestamptz(3)
  verifiedStore   Boolean        @default(false) @map("verified_store")
  role            UserRole       @default(MEMBER)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  otpChallenge    OtpChallenge?
  refreshTokens   RefreshToken[]

  @@map("users")
}

model OtpChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  codeHash   String   @map("code_hash") @db.VarChar(64)
  attempts   Int      @default(0)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSentAt DateTime @map("last_sent_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
